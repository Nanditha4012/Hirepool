# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# App branding (single source of truth — never hardcode the product name)
APP_NAME=Hirepool

# Postgres (Supabase connection string, free tier)
# Use the Supabase "Connection pooling" URI for the app, direct URI for migrations.
# Placeholder only — never commit a real connection string here.
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# Auth
# Generate real secrets with, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_64_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=12h


# Google OAuth — from your own Google Cloud Console OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# TOTP (verifier/admin 2FA) — issuer name shown in authenticator apps
TOTP_ISSUER=Hirepool

# Razorpay (Phase 6 payments) — optional; leave unset in dev and payment
# checkout endpoints will respond 503 instead of crashing the app at boot.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# SMTP (Phase 6 email notifications) — optional; leave unset in dev and
# emails are silently skipped (logged, not sent) instead of crashing the app.
# Any standard SMTP provider works (Gmail, Zoho, Brevo, Mailtrap, your own
# mail server, etc.) — just plug in its host/port/credentials below.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password_or_app_password
# EMAIL_FROM=Hirepool <no-reply@yourdomain.com>

# reCAPTCHA (Phase 7 security hardening) — optional; leave unset in dev and
# signup skips CAPTCHA verification entirely instead of crashing the app.
# RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (AI Relevancy Packages — JD parsing) — optional; leave unset and JD
# submissions are created with job_requirements_parsed.parseStatus =
# 'unavailable' instead of crashing the app. Free tier at console.groq.com.
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# Daily digest cron (End-to-End ATS) — unlike every other var above, this
# one is NOT safe to leave unset in production: without it,
# GET /internal/cron/daily-digest refuses every request (fail closed), so
# the daily digest silently never sends rather than running unauthenticated.
# Set the SAME value here and as a Vercel project env var — Vercel then
# automatically attaches it as `Authorization: Bearer $CRON_SECRET` on
# cron-invoked requests (see backend/vercel.json's `crons` entry).
# Generate with, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=replace_with_a_random_secret

# ---------------------------------------------------------------------
# Contest code execution
# ---------------------------------------------------------------------
# The contest module runs candidate code through an external judge. Two
# providers are supported and the backend picks one automatically:
#
#   PISTON_API_URL set   -> self-hosted Piston (preferred: unmetered)
#   otherwise            -> Judge0, at JUDGE0_API_URL or its public CE host
#
# With NOTHING set here it falls back to the public Judge0 CE endpoint
# (https://ce.judge0.com), which works without a key. That is rate limited
# and occasionally down, so set one of the options below for anything real.
#
# NOTE: the old default, https://emkc.org/api/v2/piston, became WHITELIST-ONLY
# on 2026-02-15 and returns 401 to unauthorised callers. It is no longer used
# as a fallback for that reason.
#
# Option 1 (best, free, unmetered): self-host Piston.
#     docker run -d --name piston -p 2000:2000 --privileged ghcr.io/engineer-man/piston
#     then install the runtimes you need, e.g.
#     curl -X POST http://localhost:2000/api/v2/packages \
#          -H 'Content-Type: application/json' \
#          -d '{"language":"python","version":"3.10.0"}'
#     (repeat for java 15.0.2, c++ 10.2.0, javascript 18.15.0)
# PISTON_API_URL=http://localhost:2000/api/v2
# PISTON_API_KEY=Bearer your_token_here   # only if it sits behind auth

# Option 2: self-hosted Judge0 (docker-compose, no key needed).
# JUDGE0_API_URL=http://localhost:2358

# Option 3: Judge0 via RapidAPI. Free tier is a few hundred calls a month —
# enough to try, not enough for a live contest.
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=your_rapidapi_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
