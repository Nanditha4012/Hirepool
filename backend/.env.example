# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# App branding (single source of truth — never hardcode the product name)
APP_NAME=Hirepool

# Postgres (Supabase connection string, free tier)
# Use the Supabase "Connection pooling" URI for the app, direct URI for migrations.
# Placeholder only — never commit a real connection string here.
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# Auth
# Generate real secrets with, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_64_byte_hex_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_64_byte_hex_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=12h


# Google OAuth — from your own Google Cloud Console OAuth 2.0 Client ID.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# TOTP (verifier/admin 2FA) — issuer name shown in authenticator apps
TOTP_ISSUER=Hirepool

# Razorpay (Phase 6 payments) — optional; leave unset in dev and payment
# checkout endpoints will respond 503 instead of crashing the app at boot.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# SMTP (Phase 6 email notifications) — optional; leave unset in dev and
# emails are silently skipped (logged, not sent) instead of crashing the app.
# Any standard SMTP provider works (Gmail, Zoho, Brevo, Mailtrap, your own
# mail server, etc.) — just plug in its host/port/credentials below.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password_or_app_password
# EMAIL_FROM=Hirepool <no-reply@yourdomain.com>

# reCAPTCHA (Phase 7 security hardening) — optional; leave unset in dev and
# signup skips CAPTCHA verification entirely instead of crashing the app.
# RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# Contest code execution (Piston)
# ---------------------------------------------------------------------
# The contest module runs candidate code through a Piston instance.
#
# IMPORTANT: the public instance at https://emkc.org/api/v2/piston became
# WHITELIST-ONLY on 2026-02-15 and now returns 401 to unauthorised callers,
# so the default below will NOT work out of the box. Until one of the two
# options here is configured, Run/Submit on coding questions return a clear
# "code execution is not configured" message and those questions score 0 —
# every MCQ and interactive question still works normally.
#
# Option 1 (recommended, free): self-host Piston and point at it.
#     docker run -d --name piston -p 2000:2000 --privileged ghcr.io/engineer-man/piston
#     then install the runtimes you need, e.g.
#     curl -X POST http://localhost:2000/api/v2/packages \
#          -H 'Content-Type: application/json' \
#          -d '{"language":"python","version":"3.10.0"}'
# PISTON_API_URL=http://localhost:2000/api/v2
#
# Option 2: use a whitelisted or hosted Piston-compatible instance that
# requires an Authorization header.
# PISTON_API_URL=https://your-piston-host/api/v2
# PISTON_API_KEY=Bearer your_token_here
